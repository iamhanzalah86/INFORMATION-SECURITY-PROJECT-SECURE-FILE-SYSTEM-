# Copy this file to ".env" and fill the values in.

# Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# 32-byte base64 key. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Never change it later or existing files can no longer be decrypted.
AES_KEY_B64=

# Key rotation: put the new key above and move the previous key(s) here (comma separated).
# Old files keep opening; new files use the new key.
# AES_KEY_OLD_B64=

# Sign-in needs password + a 6-digit emailed code. Set to 0 only for local testing.
LOGIN_MFA=1

# OPTIONAL. The first account that registers becomes the administrator on its own.
# Only fill this in to force extra admin accounts by email (comma separated).
ADMIN_EMAILS=

# HTTPS=1 serves https://127.0.0.1:5000 with a self-signed certificate and
# redirects plain HTTP. Do not use together with start-dev.bat (Vite dev server).
HTTPS=0

# Leave SMTP_* empty during development: OTP codes are printed in the Flask terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

APP_NAME=SecureVault
# DATABASE_URL=postgresql://user:pass@host/db

# DEMO ONLY: shows a "Tamper" button on each file so you can simulate an attack live.
# Never enable in production.
DEV_TOOLS=0
